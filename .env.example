APP_ENV=development
DATABASE_URL=sqlite:///./sast.db
SESSION_SECRET=generate-a-unique-secret-with-at-least-32-bytes
ACCOUNT_EMAIL_DOMAIN=company.com
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=20971520
MAX_EXTRACTED_BYTES=104857600
MAX_ARCHIVE_FILES=2000
MAX_SINGLE_FILE_BYTES=10485760
GITHUB_DOWNLOAD_TIMEOUT_SECONDS=30
PROJECT_EXPIRY_SWEEP_SECONDS=3600
SEMGREP_TIMEOUT_SECONDS=60
SEMGREP_JOBS=2
SEMGREP_MAX_MEMORY_MB=1024
SEMGREP_MAX_TARGET_BYTES=1000000
MAX_SEMGREP_OUTPUT_BYTES=20971520
MAX_SEMGREP_ERROR_BYTES=65536
